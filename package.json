{
  "name": "mechanic-city",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node -e "require('https').get(process.env.MECHANIC_CITY_MODEL_URL, r=>{const f=require('fs').createWriteStream('public/models/crown72-v4.glb');r.pipe(f);f.on('finish',()=>f.close(()=>process.exit(0))) }).on('error',e=>{console.error(e);process.exit(1)})" && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "three": "^0.181.1",
    "vite": "^7.1.7",
    "@dimforge/rapier3d-compat": "^0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}